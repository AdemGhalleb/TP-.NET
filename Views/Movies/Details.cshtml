@model TP1.Models.MovieDetailsViewModel

@{
    ViewData["Title"] = Model.Movie.Name;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="mb-1">@Model.Movie.Name</h1>
        <p class="text-secondary mb-0">
            <strong>Genre:</strong> @(Model.Movie.Genre?.Name ?? "Unknown")
        </p>
    </div>
    <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-secondary">Back to movies</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap align-items-center gap-4">
        <div>
            <div class="display-6 fw-bold">@Model.AverageRating.ToString("0.0")</div>
            <div class="rating-stars" aria-label="@Model.AverageRating.ToString("0.0") out of 5 stars">
                @for (var star = 1; star <= 5; star++)
                {
                    <span class="@(star <= Math.Round(Model.AverageRating) ? "text-warning" : "text-secondary")">&#9733;</span>
                }
            </div>
        </div>
        <div class="text-secondary">
            <strong>@Model.Reviews.Count</strong>
            @(Model.Reviews.Count == 1 ? "review" : "reviews")
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h4 mb-3">Reviews</h2>
        @if (!Model.Reviews.Any())
        {
            <div class="card border-0 bg-light">
                <div class="card-body text-center py-5">
                    <p class="h5 mb-2">No reviews yet</p>
                    <p class="text-secondary mb-0">Be the first to review this movie.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var review in Model.Reviews)
            {
                <article class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="h6 mb-1">@review.CustomerName</h3>
                                <div class="rating-stars" aria-label="@review.Rating out of 5 stars">
                                    @for (var star = 1; star <= 5; star++)
                                    {
                                        <span class="@(star <= review.Rating ? "text-warning" : "text-secondary")">&#9733;</span>
                                    }
                                </div>
                            </div>
                            <small class="text-secondary">@review.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</small>
                        </div>
                        <p class="mt-3 mb-3">@review.Comment</p>
                        <div class="d-flex gap-2">
                            <a asp-controller="Reviews" asp-action="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.Id" method="post"
                                  onsubmit="return confirm('Delete this review?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        }
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h4 mb-3">Write a review</h2>
                <form asp-controller="Reviews" asp-action="Create" asp-route-movieId="@Model.Movie.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="ReviewForm.CustomerName" class="form-label"></label>
                        <input asp-for="ReviewForm.CustomerName" class="form-control" />
                        <span asp-validation-for="ReviewForm.CustomerName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReviewForm.Rating" class="form-label"></label>
                        <select asp-for="ReviewForm.Rating" class="form-select">
                            <option value="">Select rating</option>
                            @for (var rating = 1; rating <= 5; rating++)
                            {
                                <option value="@rating">@rating - @(rating == 1 ? "Star" : "Stars")</option>
                            }
                        </select>
                        <span asp-validation-for="ReviewForm.Rating" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReviewForm.Comment" class="form-label"></label>
                        <textarea asp-for="ReviewForm.Comment" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="ReviewForm.Comment" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Submit review</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
